{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudioHub project manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "root",
    "format",
    "category",
    "gui",
    "build",
    "artifact",
    "module",
    "tests",
    "evidence",
    "measurements",
    "dependency"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string"
    },
    "root": {
      "const": "."
    },
    "format": {
      "const": "VST3"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "gui": {
      "type": "boolean"
    },
    "artifact": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
    },
    "build": {
      "type": "object",
      "required": [
        "source",
        "directory",
        "target",
        "configuration",
        "test_targets",
        "definitions"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "configuration": {
          "enum": [
            "Release",
            "Debug",
            "RelWithDebInfo"
          ]
        },
        "test_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          }
        },
        "definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      }
    },
    "measurements": {
      "type": "object",
      "required": [
        "capability"
      ],
      "properties": {
        "capability": {
          "enum": [
            "dynamics",
            "stereo-utility",
            "none"
          ]
        },
        "report": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capability": {
                "enum": [
                  "dynamics",
                  "stereo-utility"
                ]
              }
            }
          },
          "then": {
            "required": [
              "report",
              "executable"
            ]
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "required": [
        "identity",
        "fingerprint_files"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
          }
        }
      }
    }
  }
}
